{
  "name": "mpesa-node",
  "version": "0.1.3",
  "description": "Node M-Pesa Library",
  "repository": {
    "type": "git",
    "url": "https://github.com/safaricom/mpesa-node-library"
  },
  "type": "module",
  "main": "src/mpesa.js",
  "dependencies": {
    "axios": "^1.5.0",
    "globals": "^15.11.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.25.9",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.25.9",
    "@babel/register": "^7.25.9",
    "chai": "^5.1.2",
    "dotenv": "^16.3.1",
    "eslint": "^8.57.1",
    "express": "^4.21.1",
    "got": "^12.5.3",
    "jsdoc": "^4.0.2",
    "mocha": "^10.2.0",
    "ngrok": "^5.0.0-beta.2",
    "nyc": "^17.1.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.11.0",
    "uuid": "^10.0.0"
  },
  "nyc": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/"
    ],
    "all": true,
    "check-coverage": true,
    "branches": 80,
    "lines": 80,
    "functions": 80,
    "statements": 80
  },
  "scripts": {
    "test": "mocha --require @babel/polyfill --require @babel/register 'dist/tests/**/*.spec.js'",
    "test-integration": "nyc --reporter=text --reporter=html mocha --require @babel/polyfill --require @babel/register --exit 'dist/tests/**/*.js'",
    "format": "prettier --write ."
  },
  "keywords": [
    "mpesa",
    "mpesa-node",
    "mpesa-api"
  ],
  "standard": {
    "globals": [
      "describe",
      "context",
      "before",
      "beforeEach",
      "after",
      "afterEach",
      "it",
      "expect"
    ]
  },
  "author": "Geoffrey Mureithi",
  "license": "MIT"
}
