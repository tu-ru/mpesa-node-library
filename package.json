{
  "name": "mpesa-node",
  "version": "0.1.3",
  "description": "A Node.js library that integrates Daraja-2.0 APIs",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/safaricom/mpesa-node-library"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "dependencies": {
    "axios": "^1.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "globals": "^15.11.0",
    "ngrok": "^5.0.0-beta.2",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.25.9",
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "^7.25.9",
    "@babel/register": "^7.25.9",
    "chai": "^5.1.2",
    "eslint": "^9.19.0",
    "html-minifier-terser": "^7.2.0",
    "jsdoc": "^4.0.4",
    "minami": "^1.2.3",
    "mocha": "^11.1.0",
    "prettier": "^3.3.3",
    "sinon": "^19.0.2",
    "taffydb": "^2.7.3",
    "typescript-eslint": "^8.22.0"
  },
  "scripts": {
    "test": "mocha --require @babel/polyfill --require @babel/register lib/tests/apis/main/**/*.spec.js",
    "format": "prettier --write .",
    "docs": "jsdoc -c jsdoc.json"
  },
  "keywords": [
