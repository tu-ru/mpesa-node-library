    "dotenv": "^16.4.7",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.25.9",
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "^7.25.9",
    "@babel/register": "^7.25.9",
    "prettier": "^3.3.3",
    "chai": "^5.1.2",
    "eslint": "^9.19.0",
    "got": "^14.4.6",
    "jsdoc": "^4.0.4",
    "mocha": "^11.1.0",
    "typescript-eslint": "^8.22.0"
  },
  "scripts": {
    "test": "mocha --require @babel/polyfill --require @babel/register 'lib/tests/apis/**/*.spec.js'",
